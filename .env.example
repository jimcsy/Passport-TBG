DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres"
SESSION_SECRET="your-secure-session-secret"

# Course materials (private Supabase Storage bucket)
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-server-only-service-role-key"

# Optional Strobi AI (server-only; disabled until configured and implemented)
STROBI_AI_ENABLED=false
GEMINI_API_KEY=""
# Verify a free-tier structured-output model before setting this value.
GEMINI_MODEL=""
STROBI_TRAINER_DAILY_LIMIT=10
STROBI_PROJECT_DAILY_LIMIT=50
STROBI_REQUEST_TIMEOUT_MS=30000
